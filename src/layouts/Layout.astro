---
// src/layouts/Layout.astro
import '../styles/global.css';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: Array<{
    name: string;
    url?: string;
  }>;
}

const { title, description = 'Your guide to AI girlfriends and dating apps', breadcrumbs } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="FwuKEBZeCXsxE64rL7D6ooWCvpP30_VpenBxsjoCrjo" />
  
  <!-- Preconnect for Performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <title>{title} | My Top AI Girlfriend</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="bg-gray-50">
  <nav class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <a href="/" class="text-2xl font-bold text-primary-600">
            💕 My Top AI Girlfriend
          </a>
        </div>
        <div class="flex items-center space-x-8">
          <a href="/ai-girlfriends" class="text-gray-700 hover:text-primary-600">
            AI Girlfriends Review
          </a>
          <a href="/blog" class="text-gray-700 hover:text-primary-600">
            Blog
          </a>
          <a href="/submit" class="text-gray-700 hover:text-primary-600 font-semibold">
            Submit App
          </a>
          <a href="/faq" class="text-gray-700 hover:text-primary-600">
            FAQ
          </a>
          <a href="/about" class="text-gray-700 hover:text-primary-600">
            About
          </a>
          <a href="/contact" class="text-gray-700 hover:text-primary-600">
            Contact
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main class="min-h-screen">
    {breadcrumbs && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <Breadcrumb items={breadcrumbs} />
      </div>
    )}
    <slot />
  </main>

  <footer class="bg-gray-900 text-white mt-20">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        <div>
          <h3 class="text-lg font-bold mb-4">💕 My Top AI Girlfriend</h3>
          <p class="text-gray-400 text-sm">
            Honest reviews of AI girlfriend apps and virtual companions. Find your perfect match.
          </p>
        </div>
        <div>
          <h4 class="font-semibold mb-4">Reviews</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/ai-girlfriends" class="text-gray-400 hover:text-primary-400">Top 10 Rankings</a></li>
            <li><a href="/blog" class="text-gray-400 hover:text-primary-400">All Reviews</a></li>
            <li><a href="/replika" class="text-gray-400 hover:text-primary-400">Replika Review</a></li>
            <li><a href="/character-ai" class="text-gray-400 hover:text-primary-400">Character.AI Review</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-4">Company</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/about" class="text-gray-400 hover:text-primary-400">About Us</a></li>
            <li><a href="/contact" class="text-gray-400 hover:text-primary-400">Contact</a></li>
            <li><a href="/submit" class="text-gray-400 hover:text-primary-400">Submit App</a></li>
            <li><a href="/faq" class="text-gray-400 hover:text-primary-400">FAQ</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-4">Legal</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/privacy" class="text-gray-400 hover:text-primary-400">Privacy Policy</a></li>
            <li><a href="/terms" class="text-gray-400 hover:text-primary-400">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="text-center pt-8 border-t border-gray-800">
        <p class="text-gray-400 text-sm">© 2026 My Top AI Girlfriend. All rights reserved.</p>
        <p class="text-red-400 text-sm mt-2">⚠️ 18+ Content Warning: Some apps contain mature content</p>
      </div>
    </div>
  </footer>
</body>
</html>
