---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const reviews = await getCollection('en');
const aiGirlfriends = reviews.filter(r => r.data.type === 'ai_girlfriend');
const datingApps = reviews.filter(r => r.data.type === 'dating');
const comparisons = reviews.filter(r => r.data.type === 'comparison' || r.data.type === 'listicle');
---

<Layout title="Find Your Perfect AI Girlfriend or Dating App">
  <div class="bg-gradient-to-br from-pink-50 to-purple-50 py-20">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold text-gray-900 mb-6">
        Find Your Perfect AI Girlfriend or Dating App
      </h1>
      <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        Honest reviews and comparisons of AI companions, dating apps, and everything in between
      </p>
      <div class="flex justify-center gap-4">
        <a href="/ai-girlfriends" 
           class="bg-primary-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary-700 transition">
          Browse AI Girlfriends
        </a>
        <a href="/dating-apps" 
           class="bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold border-2 border-primary-600 hover:bg-primary-50 transition">
          Browse Dating Apps
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center mb-12">Popular AI Girlfriends</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {aiGirlfriends.slice(0, 6).map((review) => (
        <a href={`/${review.slug}`} class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
          <h3 class="text-xl font-bold mb-2">{review.data.app_name}</h3>
          <p class="text-gray-600 mb-4">{review.data.category}</p>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-500">{review.data.pricing}</span>
            <span class="text-primary-600 font-semibold">Read Review →</span>
          </div>
        </a>
      ))}
    </div>
    
    {comparisons.length > 0 && (
      <div class="mt-12">
        <h3 class="text-2xl font-bold mb-6">Compare & Choose</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {comparisons.map((review) => (
            <a href={`/${review.slug}`} class="bg-gradient-to-r from-purple-50 to-pink-50 p-6 rounded-lg hover:shadow-lg transition">
              <h4 class="text-lg font-bold mb-2">{review.data.title}</h4>
              <span class="text-primary-600 font-semibold">Read More →</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="bg-gray-100 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">AI Girlfriend vs Dating Apps</h2>
      <div class="bg-white p-8 rounded-lg shadow-md max-w-4xl mx-auto">
        <div class="grid grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-bold mb-4 text-primary-600">AI Girlfriends</h3>
            <ul class="space-y-2 text-gray-700">
              <li>✅ Available 24/7</li>
              <li>✅ No judgment</li>
              <li>✅ Customizable personality</li>
              <li>✅ Emotional support</li>
              <li>❌ Not a real person</li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-bold mb-4 text-blue-600">Dating Apps</h3>
            <ul class="space-y-2 text-gray-700">
              <li>✅ Real human connection</li>
              <li>✅ Potential for relationships</li>
              <li>✅ Physical meetups</li>
              <li>❌ Requires effort</li>
              <li>❌ Potential rejection</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
