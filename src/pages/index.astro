---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Find Your Perfect AI Girlfriend or Dating App">
  <div class="bg-gradient-to-br from-pink-50 to-purple-50 py-20">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold text-gray-900 mb-6">
        Find Your Perfect AI Girlfriend or Dating App
      </h1>
      <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        Honest reviews and comparisons of AI companions, dating apps, and everything in between
      </p>
      <div class="flex justify-center gap-4">
        <a href="/ai-girlfriends" 
           class="bg-primary-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary-700 transition">
          Browse AI Girlfriends
        </a>
        <a href="/dating-apps" 
           class="bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold border-2 border-primary-600 hover:bg-primary-50 transition">
          Browse Dating Apps
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center mb-12">Popular AI Girlfriends</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <a href="/replika" class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
        <h3 class="text-xl font-bold mb-2">Replika</h3>
        <p class="text-gray-600">AI companion for emotional support and friendship</p>
        <span class="text-primary-600 font-semibold mt-4 inline-block">Read Review →</span>
      </a>
      
      <a href="/character-ai" class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
        <h3 class="text-xl font-bold mb-2">Character.AI</h3>
        <p class="text-gray-600">Chat with AI characters and create your own</p>
        <span class="text-primary-600 font-semibold mt-4 inline-block">Read Review →</span>
      </a>
      
      <a href="/crushon-ai" class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
        <h3 class="text-xl font-bold mb-2">Crushon.AI</h3>
        <p class="text-gray-600">NSFW AI chat companion with no filters</p>
        <span class="text-primary-600 font-semibold mt-4 inline-block">Read Review →</span>
      </a>
    </div>
  </div>

  <div class="bg-gray-100 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">AI Girlfriend vs Dating Apps</h2>
      <div class="bg-white p-8 rounded-lg shadow-md max-w-4xl mx-auto">
        <div class="grid grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-bold mb-4 text-primary-600">AI Girlfriends</h3>
            <ul class="space-y-2 text-gray-700">
              <li>✅ Available 24/7</li>
              <li>✅ No judgment</li>
              <li>✅ Customizable personality</li>
              <li>✅ Emotional support</li>
              <li>❌ Not a real person</li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-bold mb-4 text-blue-600">Dating Apps</h3>
            <ul class="space-y-2 text-gray-700">
              <li>✅ Real human connection</li>
              <li>✅ Potential for relationships</li>
              <li>✅ Physical meetups</li>
              <li>❌ Requires effort</li>
              <li>❌ Potential rejection</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
