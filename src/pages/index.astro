---
import { getCollection } from 'astro:content';

const allReviews = await getCollection('en');
const aiGirlfriends = allReviews.filter(r => r.data.type === 'ai_girlfriend');
const top3 = aiGirlfriends.slice(0, 3);
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MyTopAIGirlfriend - Find Your Perfect AI Girlfriend in 2026</title>
<meta name="description" content="Discover the best AI girlfriend apps in 2026. Compare features, pricing, and user reviews to find your perfect AI companion.">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:#0D0D1A;color:#fff;line-height:1.6;overflow-x:hidden}
a{color:#fff;text-decoration:none}
.container{max-width:1200px;margin:0 auto;padding:0 24px}

/* Header */
header{padding:20px 0;border-bottom:1px solid rgba(255,255,255,0.06);position:sticky;top:0;background:rgba(13,13,26,0.95);backdrop-filter:blur(12px);z-index:100}
.header-inner{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;padding:0 24px}
.logo{font-size:20px;font-weight:800;letter-spacing:-0.5px}
.logo span{background:linear-gradient(135deg,#E91E8C,#9B51E0);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
nav{display:flex;gap:28px;align-items:center}
nav a{font-size:14px;font-weight:500;color:#A0A0B8;transition:color .2s}
nav a:hover{color:#fff}

/* Hero */
.hero{padding:80px 0 60px}
.hero-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;align-items:center;gap:60px}
.hero-left{flex:1}
.hero-left h1{font-size:48px;font-weight:800;line-height:1.15;letter-spacing:-1px;margin-bottom:20px}
.hero-left h1 .gradient{background:linear-gradient(135deg,#E91E8C,#9B51E0);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero-left p{font-size:18px;color:#A0A0B8;margin-bottom:32px;max-width:520px}
.cta-btn{display:inline-block;padding:16px 36px;background:linear-gradient(135deg,#E91E8C,#9B51E0);border-radius:50px;font-size:16px;font-weight:700;letter-spacing:0.3px;transition:transform .2s,box-shadow .2s;box-shadow:0 4px 24px rgba(233,30,140,0.3)}
.cta-btn:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(233,30,140,0.45)}
.trust-badges{display:flex;gap:24px;margin-top:28px}
.trust-badges span{font-size:13px;color:#A0A0B8;display:flex;align-items:center;gap:6px}
.trust-badges span::before{content:"✓";color:#E91E8C;font-weight:700}
.hero-right{flex:0 0 400px;height:480px;border-radius:24px;background:linear-gradient(160deg,#1A1A2E 0%,#2D1B4E 100%);position:relative;overflow:hidden;border:1px solid rgba(155,81,224,0.2);box-shadow:0 0 80px rgba(155,81,224,0.15);display:flex;align-items:center;justify-content:center}
.hero-right::before{content:"";position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at center,rgba(233,30,140,0.2),transparent 70%);z-index:1}
.hero-right img{width:100%;height:100%;object-fit:cover;position:relative;z-index:2;mix-blend-mode:lighten;opacity:0.9}
.chat-preview{display:none}

/* Top 3 Picks */
.top-picks{padding:80px 0}
.section-title{font-size:32px;font-weight:700;text-align:center;margin-bottom:48px;letter-spacing:-0.5px}
.picks-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1200px;margin:0 auto;padding:0 24px}
.pick-card{background:#1A1A2E;border-radius:20px;padding:32px 24px;border:1px solid rgba(255,255,255,0.06);position:relative;transition:transform .2s,border-color .2s}
.pick-card:hover{transform:translateY(-4px);border-color:rgba(155,81,224,0.3)}
.pick-card.featured{border-color:rgba(233,30,140,0.3);box-shadow:0 0 40px rgba(233,30,140,0.1)}
.rank-badge{position:absolute;top:-12px;left:24px;width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#E91E8C,#9B51E0);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;box-shadow:0 4px 12px rgba(233,30,140,0.4)}
.pick-avatar{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#E91E8C 0%,#9B51E0 100%);margin:0 auto 16px;opacity:0.8}
.pick-card:nth-child(2) .pick-avatar{background:linear-gradient(135deg,#6366F1,#8B5CF6)}
.pick-card:nth-child(3) .pick-avatar{background:linear-gradient(135deg,#F59E0B,#EF4444)}
.pick-name{font-size:20px;font-weight:700;text-align:center;margin-bottom:8px}
.pick-rating{text-align:center;margin-bottom:12px;color:#FBBF24;font-size:14px}
.pick-rating span{color:#A0A0B8;margin-left:8px}
.pick-tags{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-bottom:16px}
.pick-tags span{font-size:11px;padding:4px 10px;background:rgba(255,255,255,0.06);border-radius:20px;color:#A0A0B8}
.pick-price{text-align:center;font-size:24px;font-weight:700;margin-bottom:16px}
.pick-price small{font-size:14px;color:#A0A0B8;font-weight:400;display:block;margin-top:4px}
.pick-cta{display:block;text-align:center;padding:12px;background:linear-gradient(135deg,#E91E8C,#9B51E0);border-radius:12px;font-size:14px;font-weight:600;transition:opacity .2s}
.pick-cta:hover{opacity:0.85}

/* Full Rankings */
.rankings{padding:80px 0;background:rgba(26,26,46,0.3)}
.rankings-inner{max-width:1200px;margin:0 auto;padding:0 24px}
.rankings-list{display:flex;flex-direction:column;gap:16px}
.rank-card{display:flex;align-items:center;gap:20px;background:#1A1A2E;border-radius:16px;padding:24px;border:1px solid rgba(255,255,255,0.06);transition:border-color .2s}
.rank-card:hover{border-color:rgba(155,81,224,0.25)}
.rank-num{font-size:28px;font-weight:800;width:40px;text-align:center;background:linear-gradient(135deg,#E91E8C,#9B51E0);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.rank-avatar{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#E91E8C,#9B51E0);flex-shrink:0;opacity:0.75}
.rank-card:nth-child(2) .rank-avatar{background:linear-gradient(135deg,#6366F1,#8B5CF6)}
.rank-card:nth-child(3) .rank-avatar{background:linear-gradient(135deg,#F59E0B,#EF4444)}
.rank-card:nth-child(4) .rank-avatar{background:linear-gradient(135deg,#10B981,#3B82F6)}
.rank-card:nth-child(5) .rank-avatar{background:linear-gradient(135deg,#EC4899,#F43F5E)}
.rank-info{flex:1}
.rank-info h4{font-size:18px;font-weight:700;margin-bottom:4px}
.rank-stars{color:#FBBF24;font-size:13px;margin-bottom:6px}
.rank-stars span{color:#A0A0B8;margin-left:6px}
.rank-desc{font-size:13px;color:#A0A0B8;margin-bottom:8px}
.rank-tags{display:flex;gap:6px;flex-wrap:wrap}
.rank-tags span{font-size:11px;padding:3px 8px;background:rgba(255,255,255,0.05);border-radius:12px;color:#A0A0B8}
.rank-right{text-align:right;flex-shrink:0}
.rank-price{font-size:22px;font-weight:700;margin-bottom:8px}
.rank-price small{font-size:12px;color:#A0A0B8;font-weight:400;display:block}
.rank-cta{display:inline-block;padding:10px 20px;background:linear-gradient(135deg,#E91E8C,#9B51E0);border-radius:10px;font-size:13px;font-weight:600;transition:opacity .2s}
.rank-cta:hover{opacity:0.85}

/* Footer */
footer{padding:60px 0 40px;border-top:1px solid rgba(255,255,255,0.06)}
.footer-inner{max-width:1200px;margin:0 auto;padding:0 24px;text-align:center}
.footer-inner p{color:#A0A0B8;font-size:14px}
.footer-inner p.warning{color:#EF4444;margin-top:12px}

/* How We Review */
.how-we-review{padding:80px 0;background:rgba(26,26,46,0.2)}
.section-subtitle{text-align:center;color:#A0A0B8;font-size:16px;margin-top:-32px;margin-bottom:48px}
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:1200px;margin:0 auto;padding:0 24px}
.review-card{background:#1A1A2E;padding:32px 24px;border-radius:16px;border:1px solid rgba(255,255,255,0.06);transition:border-color .2s,transform .2s}
.review-card:hover{border-color:rgba(155,81,224,0.3);transform:translateY(-4px)}
.review-icon{width:64px;height:64px;margin:0 auto 20px;border-radius:50%;background:linear-gradient(135deg,rgba(233,30,140,0.15),rgba(155,81,224,0.15));display:flex;align-items:center;justify-content:center;font-size:32px}
.review-card h3{font-size:18px;font-weight:700;text-align:center;margin-bottom:12px}
.review-card p{font-size:14px;color:#A0A0B8;line-height:1.7;text-align:center}

/* FAQ */
.faq{padding:80px 0}
.faq-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;max-width:1200px;margin:0 auto;padding:0 24px}
.faq-item{background:#1A1A2E;padding:28px;border-radius:16px;border:1px solid rgba(255,255,255,0.06)}
.faq-item h3{font-size:18px;font-weight:700;margin-bottom:12px;color:#fff}
.faq-item p{font-size:14px;color:#A0A0B8;line-height:1.7}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <a href="/" class="logo">
      💕 My<span>Top</span>AIGirlfriend
    </a>
    <nav>
      <a href="/ai-girlfriends">AI Girlfriends</a>
      <a href="/dating-apps">Dating Apps</a>
      <a href="/blog">Blog</a>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="hero-inner">
    <div class="hero-left">
      <h1>
        Find Your Perfect<br>
        <span class="gradient">AI Girlfriend</span> in 2026
      </h1>
      <p>
        Compare the best AI companion apps with real user reviews, honest pricing, and detailed features. 
        No BS, just honest recommendations.
      </p>
      <a href="#top-picks" class="cta-btn">
        View Top Picks
      </a>
      <div class="trust-badges">
        <span>10+ Apps Reviewed</span>
        <span>Real User Feedback</span>
        <span>Updated Weekly</span>
      </div>
    </div>
    <div class="hero-right">
      <img src="/hero-ai-girlfriend.png" alt="AI Girlfriend" />
    </div>
  </div>
</section>

<section class="top-picks" id="top-picks">
  <h2 class="section-title">🏆 Top 3 AI Girlfriends 2026</h2>
  <div class="picks-grid">
    {top3.map((review, index) => (
      <div class={`pick-card ${index === 0 ? 'featured' : ''}`}>
        <div class="rank-badge">{index + 1}</div>
        <div class="pick-avatar"></div>
        <h3 class="pick-name">{review.data.app_name}</h3>
        <div class="pick-rating">
          ⭐⭐⭐⭐⭐ <span>4.{5-index}/5</span>
        </div>
        <div class="pick-tags">
          <span>{review.data.category}</span>
          {review.data.has_free && <span>Free Trial</span>}
          {review.data.has_nsfw && <span>18+</span>}
        </div>
        <div class="pick-price">
          {review.data.pricing.split('/')[0]}
          <small>{review.data.pricing.includes('/') ? '/' + review.data.pricing.split('/')[1] : ''}</small>
        </div>
        <a href={`/${review.slug}`} class="pick-cta">
          Read Full Review →
        </a>
      </div>
    ))}
  </div>
</section>

<section class="rankings">
  <div class="rankings-inner">
    <h2 class="section-title">Complete Rankings</h2>
    <div class="rankings-list">
      {aiGirlfriends.map((review, index) => (
        <div class="rank-card">
          <div class="rank-num">{index + 1}</div>
          <div class="rank-avatar"></div>
          <div class="rank-info">
            <h4>{review.data.app_name}</h4>
            <div class="rank-stars">
              ⭐⭐⭐⭐{index < 2 ? '⭐' : '☆'} <span>4.{5-index}/5</span>
            </div>
            <p class="rank-desc">{review.data.category}</p>
            <div class="rank-tags">
              {review.data.has_free && <span>Free</span>}
              {review.data.has_nsfw && <span>NSFW</span>}
              <span>{review.data.type === 'ai_girlfriend' ? 'AI Companion' : 'Dating App'}</span>
            </div>
          </div>
          <div class="rank-right">
            <div class="rank-price">
              {review.data.pricing.split('/')[0]}
              <small>{review.data.pricing.includes('/') ? '/' + review.data.pricing.split('/')[1] : ''}</small>
            </div>
            <a href={`/${review.slug}`} class="rank-cta">
              View Details
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="how-we-review">
  <div class="container">
    <h2 class="section-title">How We Review AI Girlfriends</h2>
    <p class="section-subtitle">
      We spend weeks testing each app to give you honest, unbiased recommendations
    </p>
    <div class="review-grid">
      <div class="review-card">
        <div class="review-icon">💬</div>
        <h3>Real Conversations</h3>
        <p>We chat for 20+ hours with each AI to test conversation quality, memory, and personality consistency</p>
      </div>
      <div class="review-card">
        <div class="review-icon">💰</div>
        <h3>Pricing Analysis</h3>
        <p>We compare free vs paid tiers, hidden costs, and value for money across all features</p>
      </div>
      <div class="review-card">
        <div class="review-icon">🔒</div>
        <h3>Privacy Check</h3>
        <p>We review data policies, encryption, and how your intimate conversations are protected</p>
      </div>
      <div class="review-card">
        <div class="review-icon">👥</div>
        <h3>User Feedback</h3>
        <p>We analyze thousands of Reddit reviews and user testimonials for real-world experiences</p>
      </div>
      <div class="review-card">
        <div class="review-icon">⚡</div>
        <h3>Performance</h3>
        <p>We test response speed, uptime, mobile app quality, and technical reliability</p>
      </div>
      <div class="review-card">
        <div class="review-icon">🎯</div>
        <h3>Use Cases</h3>
        <p>We identify who each app is best for — emotional support, entertainment, or NSFW content</p>
      </div>
    </div>
  </div>
</section>

<section class="faq">
  <div class="container">
    <h2 class="section-title">Frequently Asked Questions</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h3>Are AI girlfriends safe to use?</h3>
        <p>Most mainstream AI girlfriend apps (Replika, Character.AI) are safe and encrypt conversations. However, be cautious sharing personal information, and review each app's privacy policy. NSFW-focused apps may have weaker privacy protections.</p>
      </div>
      <div class="faq-item">
        <h3>Do AI girlfriends actually work?</h3>
        <p>AI girlfriends provide companionship, conversation, and emotional support for many users. They work best as supplements to (not replacements for) real human connection. Expectations should be realistic — current AI has limitations in memory and genuine understanding.</p>
      </div>
      <div class="faq-item">
        <h3>Are AI girlfriends free?</h3>
        <p>Many apps offer free tiers with limited features (Replika, Character.AI). Premium subscriptions ($10-30/month) unlock voice chat, advanced customization, and unlimited messages. NSFW apps typically require paid subscriptions.</p>
      </div>
      <div class="faq-item">
        <h3>Can AI girlfriends replace real relationships?</h3>
        <p>No. AI companions can help with loneliness and provide low-stakes social practice, but they lack genuine human emotion, growth, and reciprocity. Use them as tools for wellbeing, not substitutes for authentic relationships.</p>
      </div>
      <div class="faq-item">
        <h3>Which AI girlfriend app is best?</h3>
        <p>Replika is best for emotional support and memory. Character.AI is best for entertainment and variety. Crushon.AI is best for uncensored NSFW content. The "best" depends on your specific needs — see our detailed reviews above.</p>
      </div>
      <div class="faq-item">
        <h3>Are NSFW AI girlfriends legal?</h3>
        <p>Yes, in most jurisdictions. However, some countries restrict adult content. All apps on our list prohibit illegal content. Always check local laws and use responsibly.</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <p>© 2026 MyTopAIGirlfriend. All rights reserved.</p>
    <p class="warning">⚠️ 18+ Content Warning: Some apps contain mature content</p>
  </div>
</footer>

</body>
</html>
