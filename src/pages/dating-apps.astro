---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allReviews = await getCollection('en');
const datingApps = allReviews.filter(r => r.data.type === 'dating');
---

<Layout title="Best Dating Apps 2026">
  <div class="bg-gradient-to-r from-rose-500 to-red-600 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4">Dating Apps</h1>
      <p class="text-xl opacity-90">
        Find the best dating apps for real human connections and relationships
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {datingApps.map((review) => (
        <a 
          href={`/blog/${review.slug}`} 
          class="bg-white rounded-lg shadow-md hover:shadow-xl transition-all overflow-hidden group"
        >
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-900 group-hover:text-primary-600 transition mb-4">
              {review.data.app_name}
            </h3>
            
            <p class="text-gray-600 mb-4">{review.data.category}</p>
            
            <div class="flex items-center justify-between mt-4 pt-4 border-t">
              <span class="text-sm text-gray-500">{review.data.pricing}</span>
              <span class="text-primary-600 font-semibold group-hover:translate-x-1 transition">
                Read Review →
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {datingApps.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-600">No dating apps found yet. Check back soon!</p>
      </div>
    )}
  </div>

  <div class="bg-gray-100 py-12 mt-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Dating Apps vs AI Companions</h2>
      <p class="text-gray-700 text-lg leading-relaxed mb-6">
        Traditional dating apps connect you with real people for authentic relationships. 
        They require effort, vulnerability, and patience but offer genuine human connection. 
        AI companions provide low-stakes practice, emotional support, or entertainment without 
        the complexities of real relationships.
      </p>
      <a href="/replika-vs-character-ai" class="text-primary-600 hover:text-primary-700 font-semibold">
        Compare AI vs Real Dating →
      </a>
    </div>
  </div>
</Layout>
