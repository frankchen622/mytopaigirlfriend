---
import { getCollection } from 'astro:content';

const allReviews = await getCollection('es');
const aiGirlfriends = allReviews.filter(r => r.data.type === 'ai_girlfriend');

// Define Top 10 in specific order based on our rankings
const top10Order = [
  'candy-ai',
  'replika',
  'character-ai',
  'herahaven-ai',
  'dreamgf',
  'luvr-ai',
  'kupid-ai',
  'infatuated-ai',
  'swipeyai',
  'fantasygf-ai'
];

// Sort aiGirlfriends according to top10Order
const top10 = top10Order
  .map(slug => aiGirlfriends.find(app => app.slug === slug))
  .filter(Boolean)
  .slice(0, 10);

const top3 = top10.slice(0, 3);
