---
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('es');
const allReviews = await getCollection('es');
const aiGirlfriends = allReviews.filter(r => r.data.type === 'ai_girlfriend' || r.data.type === 'comparison');

// Define Top 10 in specific order based on our rankings
const top10Order = [
  'candy-ai',
  'dreamgf',
  'replika',
  'character-ai',
  'anima-ai',
];

// Sort aiGirlfriends according to top10Order (only ones we have Spanish content for)
const top10 = top10Order
  .map(slug => aiGirlfriends.find(app => app.slug === slug))
  .filter(Boolean);

const top3 = top10.slice(0, 3);
