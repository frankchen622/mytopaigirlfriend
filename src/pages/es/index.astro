            <p class="rank-desc">{review.data.category}</p>
            <div class="rank-tags">
              {review.data.has_free && <span>Gratis</span>}
              {review.data.has_nsfw && <span>NSFW</span>}
              <span>{review.data.type === 'ai_girlfriend' ? 'Compañera IA' : 'App de Citas'}</span>
            </div>
          </div>
          <div class="rank-right">
            <div class="rank-price">
              {review.data.pricing.split('/')[0]}
              <small>{review.data.pricing.includes('/') ? '/' + review.data.pricing.split('/')[1] : ''}</small>
            </div>
            <a href={`/es/${review.slug}`} class="rank-cta">
              Ver Detalles de {review.data.app_name}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

