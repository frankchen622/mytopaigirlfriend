---
// src/pages/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('en');
  return reviews.map((review) => ({
    params: { slug: review.slug },
    props: { review },
  }));
}

const { review } = Astro.props;
const { Content } = await review.render();
---

<Layout title={review.data.title}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{review.data.title}</h1>
      <div class="flex gap-4 text-gray-600 text-sm">
        <span>App: {review.data.app_name}</span>
        <span>•</span>
        <span>Category: {review.data.category}</span>
        {review.data.has_nsfw && (
          <>
            <span>•</span>
            <span class="text-red-600">18+ NSFW</span>
          </>
        )}
      </div>
    </header>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <footer class="mt-12 pt-8 border-t">
      <a href="/" class="text-primary-600 hover:text-primary-700">
        ← Back to Home
      </a>
    </footer>
  </article>
</Layout>
