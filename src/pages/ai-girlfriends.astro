---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allReviews = await getCollection('en');
const aiGirlfriends = allReviews.filter(r => r.data.type === 'ai_girlfriend');
---

<Layout title="Best AI Girlfriend Apps 2026">
  <div class="bg-gradient-to-r from-pink-500 to-purple-600 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4">AI Girlfriend Apps</h1>
      <p class="text-xl opacity-90">
        Explore the best AI companions for emotional support, entertainment, and companionship
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {aiGirlfriends.map((review) => (
        <a 
          href={`/${review.slug}`} 
          class="bg-white rounded-lg shadow-md hover:shadow-xl transition-all overflow-hidden group"
        >
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-2xl font-bold text-gray-900 group-hover:text-primary-600 transition">
                {review.data.app_name}
              </h3>
              {review.data.has_nsfw && (
                <span class="text-xs bg-red-100 text-red-700 px-2 py-1 rounded">
                  18+
                </span>
              )}
            </div>
            
            <p class="text-gray-600 mb-4">{review.data.category}</p>
            
            <div class="flex items-center justify-between mt-4 pt-4 border-t">
              <span class="text-sm text-gray-500">{review.data.pricing}</span>
              <span class="text-primary-600 font-semibold group-hover:translate-x-1 transition">
                Read Review →
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {aiGirlfriends.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-600">No AI girlfriend apps found yet. Check back soon!</p>
      </div>
    )}
  </div>

  <div class="bg-gray-100 py-12 mt-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">What Are AI Girlfriends?</h2>
      <p class="text-gray-700 text-lg leading-relaxed">
        AI girlfriend apps use advanced language models to simulate companionship, conversation, 
        and emotional support. They range from wholesome emotional support bots to more mature 
        NSFW companions. Whether you're seeking genuine connection or just entertainment, 
        our reviews help you find the right AI companion.
      </p>
    </div>
  </div>
</Layout>
