---
import { getCollection } from 'astro:content';
import ComparisonGuide from '../components/ComparisonGuide.astro';

const allReviews = await getCollection('en');
const aiGirlfriends = allReviews.filter(r => r.data.type === 'ai_girlfriend');

// Define Top 10 in specific order based on our rankings
const top10Order = [
  'candy-ai',
  'replika',
  'character-ai',
  'herahaven-ai',
  'dreamgf',
  'luvr-ai',
  'kupid-ai',
  'infatuated-ai',
  'swipeyai',
  'fantasygf-ai'
];

// Sort aiGirlfriends according to top10Order and limit to 10
const top10 = top10Order
  .map(slug => aiGirlfriends.find(app => app.slug === slug))
  .filter(Boolean)
  .slice(0, 10);
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Best AI Girlfriend Apps 2026 - Complete Guide</title>
<meta name="description" content="Compare all AI girlfriend apps: Replika, Character.AI, Chai, and more. Honest reviews, pricing, and features.">

<!-- Schema.org BreadcrumbList -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://mytopaigirlfriend.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "AI Girlfriends",
      "item": "https://mytopaigirlfriend.com/ai-girlfriends"
    }
  ]
}
</script>

<!-- Schema.org ItemList for Rankings -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Top 10 AI Girlfriend Apps 2026",
  "description": "Complete ranked list of best AI girlfriend apps with reviews",
  "numberOfItems": top10.length,
  "itemListElement": top10.map((review, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": review.data.app_name,
      "description": review.data.category,
      "url": `https://mytopaigirlfriend.com/blog/${review.slug}`,
      "aggregateRating": review.data.rating ? {
        "@type": "AggregateRating",
        "ratingValue": review.data.rating.toString(),
        "bestRating": "5",
        "ratingCount": "50"
      } : undefined,
      "offers": {
        "@type": "Offer",
        "price": review.data.has_free ? "0" : review.data.pricing.split('/')[0].replace('$', ''),
        "priceCurrency": "USD"
      }
    }
  }))
})}></script>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://mytopaigirlfriend.com/ai-girlfriends">
<meta property="og:title" content="Best AI Girlfriend Apps 2026 - Complete Reviews">
<meta property="og:description" content="Compare top 10 AI girlfriend apps with detailed reviews, pricing, and features. Find your perfect AI companion.">
<meta property="og:image" content="https://mytopaigirlfriend.com/hero-ai-girlfriend.png">
<meta property="og:site_name" content="My Top AI Girlfriend">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Best AI Girlfriend Apps 2026 - Complete Reviews">
<meta name="twitter:description" content="Compare top 10 AI girlfriend apps with detailed reviews.">
<meta name="twitter:image" content="https://mytopaigirlfriend.com/hero-ai-girlfriend.png">

<!-- Canonical URL -->
<link rel="canonical" href="https://mytopaigirlfriend.com/ai-girlfriends">

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:#0D0D1A;color:#fff;line-height:1.6}

header{padding:20px 0;border-bottom:1px solid rgba(255,255,255,0.06);background:rgba(13,13,26,0.95)}
.header-inner{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;padding:0 24px}
.logo{font-size:20px;font-weight:800;color:#fff;text-decoration:none}
.logo span{background:linear-gradient(135deg,#E91E8C,#9B51E0);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
nav{display:flex;gap:28px}
nav a{font-size:14px;font-weight:500;color:#A0A0B8;transition:color .2s;text-decoration:none}
nav a:hover{color:#fff}

/* Breadcrumb */
.breadcrumb{background:rgba(26,26,46,0.5);border-bottom:1px solid rgba(255,255,255,0.06);padding:12px 0}
.breadcrumb ol{list-style:none;display:flex;align-items:center;gap:8px;max-width:1200px;margin:0 auto;padding:0 24px;font-size:14px}
.breadcrumb li{display:flex;align-items:center;gap:8px;color:#A0A0B8}
.breadcrumb li:not(:last-child):after{content:"›";color:#6B7280;font-size:16px}
.breadcrumb a{color:#A0A0B8;transition:color .2s;text-decoration:none}
.breadcrumb a:hover{color:#E91E8C}
.breadcrumb li[aria-current="page"]{color:#fff;font-weight:500}

.hero{padding:60px 0 40px;background:linear-gradient(160deg,#1A1A2E 0%,#2D1B4E 100%)}
.hero-inner{max-width:1200px;margin:0 auto;padding:0 24px;text-align:center}
.hero h1{font-size:42px;font-weight:800;margin-bottom:12px}
.hero p{font-size:16px;color:#A0A0B8;max-width:600px;margin:0 auto}

.rankings{padding:60px 0;max-width:1200px;margin:0 auto;padding:60px 24px}
.rank-list{display:flex;flex-direction:column;gap:16px}
.rank-card{display:flex;align-items:center;gap:20px;background:#1A1A2E;border-radius:16px;padding:24px;border:1px solid rgba(255,255,255,0.06);transition:border-color .2s}
.rank-card:hover{border-color:rgba(155,81,224,0.25)}
.rank-num{font-size:28px;font-weight:800;width:40px;text-align:center;background:linear-gradient(135deg,#E91E8C,#9B51E0);-webkit-background-clip:text;-webkit-text-fill-color:transparent;flex-shrink:0}
.rank-avatar{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#E91E8C,#9B51E0);flex-shrink:0;opacity:0.75}
.rank-card:nth-child(2) .rank-avatar{background:linear-gradient(135deg,#6366F1,#8B5CF6)}
.rank-card:nth-child(3) .rank-avatar{background:linear-gradient(135deg,#F59E0B,#EF4444)}
.rank-card:nth-child(4) .rank-avatar{background:linear-gradient(135deg,#10B981,#3B82F6)}
.rank-card:nth-child(5) .rank-avatar{background:linear-gradient(135deg,#EC4899,#F43F5E)}
.rank-info{flex:1}
.rank-info h4{font-size:18px;font-weight:700;color:#fff;margin-bottom:4px}
.rank-rating{color:#FBBF24;font-size:14px;margin-bottom:6px}
.rank-rating span{color:#A0A0B8;margin-left:6px;font-weight:500}
.rank-desc{font-size:13px;color:#A0A0B8;margin-bottom:8px}
.rank-tags{display:flex;gap:6px;flex-wrap:wrap}
.rank-tags span{font-size:11px;padding:3px 8px;background:rgba(255,255,255,0.05);border-radius:12px;color:#A0A0B8}
.rank-right{text-align:right;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:12px}
.rank-price{font-size:22px;font-weight:700;color:#fff}
.rank-price small{font-size:12px;color:#A0A0B8;font-weight:400;display:block;margin-top:2px}
.rank-actions{display:flex;gap:8px}
.rank-btn{display:inline-block;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;transition:all .2s;white-space:nowrap}
.rank-btn-primary{background:linear-gradient(135deg,#E91E8C,#9B51E0);color:#fff}
.rank-btn-primary:hover{opacity:0.85;transform:translateY(-1px)}
.rank-btn-secondary{background:rgba(255,255,255,0.08);color:#fff;border:1px solid rgba(255,255,255,0.1)}
.rank-btn-secondary:hover{background:rgba(255,255,255,0.12);border-color:rgba(155,81,224,0.3)}

@media (max-width: 768px) {
  .rank-card{flex-direction:column;align-items:flex-start;gap:16px}
  .rank-num{width:auto;margin-bottom:8px}
  .rank-right{width:100%;align-items:flex-start}
  .rank-actions{width:100%;flex-direction:column}
  .rank-btn{width:100%;text-align:center}
}

.comparison-guide{max-width:1200px;margin:80px auto 0;padding:0 24px}
.comparison-guide h1{font-size:36px;font-weight:800;margin-bottom:20px;line-height:1.2}
.comparison-guide h2{font-size:28px;font-weight:700;margin:48px 0 16px;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:12px}
.comparison-guide h3{font-size:22px;font-weight:600;margin:32px 0 12px;color:#A0A0B8}
.comparison-guide p{margin:12px 0;color:#D1D5DB;line-height:1.8}
.comparison-guide ul,.comparison-guide ol{margin:12px 0 12px 24px;color:#D1D5DB}
.comparison-guide li{margin:8px 0}
.comparison-guide a{color:#9B51E0;text-decoration:underline;transition:color .2s}
.comparison-guide a:hover{color:#E91E8C}
.comparison-guide blockquote{border-left:4px solid #9B51E0;padding:12px 20px;margin:20px 0;background:rgba(155,81,224,0.05);font-style:italic;color:#A0A0B8}
.comparison-guide table{width:100%;border-collapse:collapse;margin:24px 0;font-size:14px}
.comparison-guide th{background:#1A1A2E;padding:12px;text-align:left;font-weight:600;border-bottom:2px solid rgba(255,255,255,0.1)}
.comparison-guide td{padding:12px;border-bottom:1px solid rgba(255,255,255,0.06)}
.comparison-guide code{background:rgba(155,81,224,0.1);padding:2px 6px;border-radius:4px;font-size:13px;color:#E91E8C}
.comparison-guide hr{border:none;border-top:1px solid rgba(255,255,255,0.06);margin:48px 0}
.comparison-guide strong{color:#fff;font-weight:600}

footer{padding:60px 0 40px;border-top:1px solid rgba(255,255,255,0.06);text-align:center;margin-top:80px}
footer p{color:#A0A0B8;font-size:14px}
footer .warning{color:#EF4444;margin-top:12px}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <a href="/" class="logo">
      💕 My<span>Top</span>AIGirlfriend
    </a>
    <nav>
      <a href="/ai-girlfriends">AI Girlfriends Review</a>
      
      <a href="/blog">Blog</a>
    </nav>
  </div>
</header>

<!-- Breadcrumb Navigation -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol itemscope itemtype="https://schema.org/BreadcrumbList">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item">
        <span itemprop="name">Home</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
      <span itemprop="name">AI Girlfriends</span>
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>

<section class="hero">
  <div class="hero-inner">
    <h1>Top 10 AI Girlfriend Apps</h1>
    <p>
      Complete guide to every AI companion app. Compare features, pricing, and find your perfect match.
    </p>
  </div>
</section>

<section class="rankings">
  <div class="rank-list">
    {top10.map((review, index) => (
      <div class="rank-card">
        <div class="rank-num">{index + 1}</div>
        <div class="rank-avatar"></div>
        <div class="rank-info">
          <h4>{review.data.app_name}</h4>
          <div class="rank-rating">
            {review.data.rating ? (
              <>
                {'⭐'.repeat(Math.floor(review.data.rating))}
                {review.data.rating % 1 >= 0.5 ? '⭐' : review.data.rating % 1 > 0 ? '☆' : ''}
                <span>{review.data.rating}/5</span>
              </>
            ) : (
              <span style="color:#6B7280">No rating yet</span>
            )}
          </div>
          <p class="rank-desc">{review.data.category}</p>
          <div class="rank-tags">
            {review.data.has_free && <span>Free</span>}
            {review.data.has_nsfw && <span>NSFW</span>}
            <span>AI Companion</span>
          </div>
        </div>
        <div class="rank-right">
          <div class="rank-price">
            {review.data.pricing.split('/')[0]}
            <small>{review.data.pricing.includes('/') ? '/' + review.data.pricing.split('/')[1] : ''}</small>
          </div>
          <div class="rank-actions">
            {review.data.app_url && (
              <a href={review.data.app_url} target="_blank" rel="noopener noreferrer" class="rank-btn rank-btn-primary">
                Visit Website
              </a>
            )}
            <a href={`/blog/${review.slug}`} class="rank-btn rank-btn-secondary">
              Read Review
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<article class="comparison-guide">
  <ComparisonGuide />
</article>

<footer>
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;text-align:center">
    <p style="color:#A0A0B8;font-size:14px">© 2026 MyTopAIGirlfriend. All rights reserved.</p>
    <div style="display:flex;gap:12px;justify-content:center;align-items:center;margin:12px 0;font-size:13px">
      <a href="/about" style="color:#A0A0B8;transition:color .2s;text-decoration:underline">About Us</a>
      <span style="color:#6B7280">•</span>
      <a href="/contact" style="color:#A0A0B8;transition:color .2s;text-decoration:underline">Contact</a>
      <span style="color:#6B7280">•</span>
      <a href="/faq" style="color:#A0A0B8;transition:color .2s;text-decoration:underline">FAQ</a>
      <span style="color:#6B7280">•</span>
      <a href="/privacy" style="color:#A0A0B8;transition:color .2s;text-decoration:underline">Privacy Policy</a>
      <span style="color:#6B7280">•</span>
      <a href="/terms" style="color:#A0A0B8;transition:color .2s;text-decoration:underline">Terms of Service</a>
    </div>
    <p class="warning" style="color:#EF4444;margin-top:12px">⚠️ 18+ Content Warning: Some apps contain mature content</p>
  </div>
</footer>

</body>
</html>
